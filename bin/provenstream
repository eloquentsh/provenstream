# Run the provenstream command line from this checkout without installing it (or: pip install ./host).
HERE="$(cd "$(dirname "$0")/.." && pwd)"
PYTHONPATH="$HERE/host${PYTHONPATH:+:$PYTHONPATH}" exec "${PYTHON:-python3}" -m provenstream "$@"
